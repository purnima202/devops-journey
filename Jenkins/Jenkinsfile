pipeline {
    agent any

    tools {
        nodejs 'NodeJS-20'
    }

    environment {
        DOCKER_IMAGE = 'purnimajd20/jenkins-ci-cd-demo'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('Jenkins/app') {
                    sh 'npm ci'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('Jenkins/app') {
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'Jenkins/app/test-results/junit.xml'
                }
            }
        }

        stage('Build') {
            steps {
                dir('Jenkins/app') {
                    sh 'npm pack --dry-run'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Jenkins/app') {
                    sh '''
                        docker build \
                          -t $DOCKER_IMAGE:$BUILD_NUMBER \
                          -t $DOCKER_IMAGE:latest .
                    '''
                }
            }
        }

        stage('Docker Hub Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''
                        echo "$DOCKERHUB_TOKEN" | docker login \
                          -u "$DOCKERHUB_USER" --password-stdin

                        docker push $DOCKER_IMAGE:$BUILD_NUMBER
                        docker push $DOCKER_IMAGE:latest

                        docker logout
                    '''
                }
            }
        }
    }
}
